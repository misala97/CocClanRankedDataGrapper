+        return 'bullish'
+    if verdict == 'bearish':
+        return 'bearish'
+    if verdict is not None:            # 'neutral' or 'unclear'
+        return None
+    if lexicon and lexicon > 0:
+        return 'bullish'
+    if lexicon and lexicon < 0:
+        return 'bearish'
+    return None
