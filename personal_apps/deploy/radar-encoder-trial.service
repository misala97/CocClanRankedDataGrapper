# The encoder trial's watchdog.
#
# Independent of radar_ingest ON PURPOSE: the thing most likely to need
# stopping is the daemon, and a deadline enforced by the process it governs
# is not enforced at all. This reads the trial row, and when the ten days
# are up without a passing audit it persists `recovering` and drains a
# bounded slice of the recovery.
#
# It never constructs a judge, never opens the model artifact, and needs no
# API key. It needs the database and nothing else, so it still works when
# the thing it is stopping is broken.
#
# Paths below are the deployed layout (see the deployment runbook); confirm
# them against the installed radar_ingest unit before enabling, rather than
# assuming this file is right about somebody else's server.

[Unit]
Description=Radar encoder trial watchdog (deadline enforcement)
After=network-online.target mariadb.service
Wants=mariadb.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/coc-stats/personal_apps
EnvironmentFile=/root/coc-stats/.env
ExecStart=/root/coc-stats/venv/bin/python -m scripts.manage_encoder_trial tick --limit 2000

# A tick that fails must be visible and must not retry in a tight loop: the
# next timer firing is one minute away, and a database that is down will
# still be down in a second.
Restart=no
StandardOutput=journal
StandardError=journal
